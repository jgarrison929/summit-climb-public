# Export these in your shell before `npm start` (the server reads process.env; it does not load .env files). All are optional for local play.
PORT=3000
# Postgres for the global leaderboard, e.g. postgres://user:pass@localhost:5432/summitclimb
DATABASE_URL=
# disable | require | no-verify
DATABASE_SSL=
# HMAC key for run tokens (at least 16 chars). Generate with: openssl rand -hex 32
RUN_SECRET=
# Enables the moderation endpoint when set (at least 24 chars).
ADMIN_TOKEN=
# Enables GET /api/stats and POST /api/stats/internal when set (at least 24 chars).
STATS_TOKEN=
